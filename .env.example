LLM_BASE_URL=http://llm.internal:8000/v1
LLM_MODEL=
EMBED_BASE_URL=http://embed.internal:8001/v1
EMBED_MODEL=bge-m3
# Embedding tokenizer + limits (LLD-RET-02). EMBED_TOKENIZER is an HF repo id resolved
# from the local cache; set EMBED_TOKENIZER_PATH to a local tokenizer.json / dir for an
# air-gapped install. A chunk at/over EMBED_LIMIT tokens raises ChunkTooLargeError (never
# silent truncation); EMBED_NUM_CTX (≥ limit + margin) is sent to the provider per request.
EMBED_TOKENIZER=BAAI/bge-m3
EMBED_TOKENIZER_PATH=
EMBED_DIM=1024
EMBED_LIMIT=8192
EMBED_NUM_CTX=8448
EMBED_BATCH=64
# Offline extractor LLM (CR-0002) — may be an external API; public content only.
# Leave blank to fall back to LLM_BASE_URL / LLM_MODEL (self-hosted).
EXTRACT_LLM_BASE_URL=
EXTRACT_LLM_MODEL=
EXTRACT_LLM_API_KEY=
# Provider sampling knobs — each sent only when set (blank → omitted).
# reasoning_effort: kimi-k3 accepts low|high|max (blank → provider default).
EXTRACT_LLM_REASONING_EFFORT=
# temperature: leave BLANK for kimi-k3 (it rejects temperature); a self-hosted
# model may set 0 for determinism.
EXTRACT_LLM_TEMPERATURE=
EXTRACT_LLM_MAX_COMPLETION_TOKENS=
# Optional external-API price per 1k tokens for cost reporting (blank → n/a).
# CACHED_IN is the discounted rate for prompt-cache hits (kimi-k3: ~$0.30/1M =
# 0.0003/1k vs ~$3/1M miss); blank → cached tokens billed at the miss rate.
EXTRACT_LLM_PRICE_IN_PER_1K=
EXTRACT_LLM_PRICE_OUT_PER_1K=
EXTRACT_LLM_PRICE_CACHED_IN_PER_1K=
DATABASE_URL=postgresql+psycopg://agent:change-me@localhost:5433/jyotech_v1
SMTP_URL=smtp://user:pass@smtp.internal:587
